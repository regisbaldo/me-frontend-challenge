{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,vue,scss}\" \"cypress/**/*.cy.js\"",
    "test": "npm run test:component && npm run test:e2e",
    "test:component": "cypress run --component",
    "test:component:open": "cypress open --component",
    "test:e2e": "start-server-and-test dev http://localhost:5173 'cypress run --e2e'",
    "test:e2e:open": "start-server-and-test dev http://localhost:5173 'cypress open --e2e'",
    "test:watch": "cypress open"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "pinia": "^3.0.3",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@cypress/vue": "^6.0.2",
    "@eslint/js": "^9.31.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "cypress": "^15.0.0",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "~10.3.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "sass": "^1.90.0",
    "start-server-and-test": "^2.0.13",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0"
  }
}
